# Development uses SQLite when DATABASE_URL is omitted.
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=True
SECRET_KEY=replace-with-a-random-value-of-at-least-50-characters
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Staging requires PostgreSQL, HTTPS origins, and access credentials.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# DJANGO_ENVIRONMENT=staging
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=staging.example.com
# CSRF_TRUSTED_ORIGINS=https://staging.example.com
# WAGTAILADMIN_BASE_URL=https://staging.example.com
# STAGING_ACCESS_USERNAME=reviewer
# STAGING_ACCESS_PASSWORD=replace-with-a-long-random-password
# TRUST_X_FORWARDED_PROTO=True
# HEALTH_CHECK_HOST=staging.example.com
# MEDIA_ROOT=/var/lib/arya-skin/media
# SITE_NOINDEX=True
# LOG_LEVEL=INFO

# Production uses PostgreSQL and requires Cloudflare R2 for durable public media.
# Create a token scoped only to the media bucket. Never commit real credentials.
# DJANGO_ENVIRONMENT=production
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=drnareshrathod.com,www.drnareshrathod.com
# CSRF_TRUSTED_ORIGINS=https://drnareshrathod.com,https://www.drnareshrathod.com
# WAGTAILADMIN_BASE_URL=https://drnareshrathod.com
# TRUST_X_FORWARDED_PROTO=True
# HEALTH_CHECK_HOST=drnareshrathod.com
# USE_R2_MEDIA=True
# R2_MEDIA_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key-id
# R2_MEDIA_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-access-key
# R2_MEDIA_BUCKET_NAME=arya-skin-production-media
# R2_MEDIA_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
# R2_MEDIA_CUSTOM_DOMAIN=media.drnareshrathod.com
# SITE_NOINDEX=False
# LOG_LEVEL=INFO
