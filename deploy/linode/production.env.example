APP_IMAGE=arya-skin:production-release
PRODUCTION_HOST=drnareshrathod.com
WWW_HOST=www.drnareshrathod.com
DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=False
SECRET_KEY=preserve-the-existing-server-secret
POSTGRES_DB=arya_skin
POSTGRES_USER=arya_skin
POSTGRES_PASSWORD=preserve-the-existing-database-password
DATABASE_URL=postgresql://arya_skin:preserve-the-existing-database-password@db:5432/arya_skin
ALLOWED_HOSTS=drnareshrathod.com,www.drnareshrathod.com
CSRF_TRUSTED_ORIGINS=https://drnareshrathod.com,https://www.drnareshrathod.com
WAGTAILADMIN_BASE_URL=https://drnareshrathod.com
TRUST_X_FORWARDED_PROTO=True
HEALTH_CHECK_HOST=drnareshrathod.com
SITE_NOINDEX=False
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
WEB_CONCURRENCY=1
GUNICORN_THREADS=2
LOG_LEVEL=INFO
R2_MEDIA_ENV_FILE=/srv/arya-skin/secrets/r2-media.env
POSTGRES_VOLUME=arya-skin-staging_postgres_data
MEDIA_IMPORT_VOLUME=arya-skin-staging_media_data
CADDY_DATA_VOLUME=arya-skin-staging_caddy_data
CADDY_CONFIG_VOLUME=arya-skin-staging_caddy_config
