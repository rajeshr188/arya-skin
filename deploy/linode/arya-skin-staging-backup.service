[Unit]
Description=Arya Skin staging database and media backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=arya-deploy
Group=arya-deploy
SupplementaryGroups=docker
WorkingDirectory=/srv/arya-skin/staging
UMask=0077
RuntimeDirectory=arya-skin-backup-docker
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/arya-skin-backup-docker
ExecStart=/srv/arya-skin/staging/backup_staging.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/arya-skin/backups
CapabilityBoundingSet=
